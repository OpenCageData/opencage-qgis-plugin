[flake8]
max-line-length = 99

# N801 class name should use CapWords convention
#      auto-generated Ui_Form in ui/settings.py uses Qt naming convention
# N802,N803,N806 QGIS/Qt API requires camelCase method/variable names
#      (initGui, createInstance, fieldList, etc.)
# E501 line too long - no line length limit enforced

extend-ignore = N801,N802,N803,N806,E501
exclude = .git,__pycache__,.venv
